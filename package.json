{
  "name": "ronghua",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bench:particles": "node tools/benchmark-particles.mjs",
    "test": "node --test test/*.test.ts",
    "build:wasm": "zig cc -target wasm32-freestanding -mcpu=mvp -std=c11 -O3 -Wall -Wextra -Werror -ffreestanding -fno-fast-math -ffp-contract=off -nostdlib -Wl,--entry=advance -Wl,-z,stack-size=4096 -s wasm/particle-solver.c -o wasm/particle-solver.wasm",
    "build": "tsc --noEmit && vite build && node tools/inline-build.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
